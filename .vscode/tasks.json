{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "OBill: dev (build + install loop)",
      "type": "shell",
      "command": "./scripts/dev-emulator.sh",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "ANDROID_HOME": "${env:ANDROID_HOME}"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "OBill: install debug + jalankan (sekali)",
      "type": "shell",
      "command": "./gradlew :app:installDebugAndRun",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
